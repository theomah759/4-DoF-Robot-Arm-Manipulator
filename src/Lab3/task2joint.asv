clc
% Create a robot object
robot = Robot();
travel_time = 5;
homePos = zeros(1,4); % Defines home position
samples = 1000; % Number of Overall Samples that can be taken
m = 0; % Actual Samples Taken - Variable Size

storeJointPos = zeros(samples,4); % Creates a matrix to store joint positions
storeTaskPos = zeros(samples,4);

x = zeros(1, 4); % Creates a matrix to store EE x position
y = zeros(1, 4); % Creates a matrix to store EE y position
z = zeros(1, 4); % Creates a matrix to store EE z position
theta2 = zeros(1, 4); % Creates a matrix to store joint 2's position
theta3 = zeros(1, 4); % Creates a matrix to store joint 3's position
theta4 = zeros(1, 4); % Creates a matrix to store joint 4's position

robot.interpolate_jp(homePos, travel_time); % Moves all joints to zero positions
pause(4); % Ensures all joints are able to reach zero position before setting target position

% Define three [x, y, z, alpha] positions for your end effector that all
% lie upon the x-z plane of your robot

% For each leg of your triangle, calculate the TASK SPACE trajectory
% between each vetex. Remember, to calculate a task space trajectory
% you will need to create individual trajectories for x, y, z, and alpha.

% Move your robot to the first vertex
fk = [0,   45, -45, -35; % Defines target joint positions
      0,  -20, -70,  90;
      0,    0,   0,   0];
pos1 = robot.fk3001(fk(1,:)).';
pos2 = robot.fk3001(fk(2,:)).';
pos3 = robot.fk3001(fk(3,:)).';

ikPos = [robot.ik3001([pos1(4,1:3), (fk(1,2)+fk(1,3)+fk(1,4))]);
         robot.ik3001([pos2(4,1:3), (fk(2,2)+fk(2,3)+fk(2,4))]);
         robot.ik3001([pos3(4,1:3), (fk(3,2)+fk(3,3)+fk(3,4))])];

% Create a for loop that sends your robot to each vertex, recording the
% JOINT-SPACE position the entire time
for i = 1:size(ikPos, 1)
    tic;
    robot.interpolate_jp(ikPos(i,:),travel_time);

    while toc < travel_time
        m = m + 1; % Records number of actual samples taken

        % jointPos = robot.fk3001(ikPos(i,:));

        output = robot.measure_js(true, false); % Records the current joint positions at each timestamp
    
        % Stores the positions in a matrix
        storeJointPos(m,:) = output(1, :);
        
        % Evaluate your trajectory using eval_traj
        % Pass your target x, y, z, alpha into IK to get joint values
        
        % tic;

        %  while toc < travel_time
        % 
        % xStateTrajCubic = TrajGenerator.eval_traj(xCubic', toc);
        % yStateTrajCubic = TrajGenerator.eval_traj(yCubic', toc);
        % zStateTrajCubic = TrajGenerator.eval_traj(zCubic', toc);
        % 
        % 
        % x = [x, xStateTrajCubic];
        % y = [y, yStateTrajCubic];
        % z = [z, zStateTrajCubic];
        % 
        %  end


    end
end

    jointPos = storeJointPos.';

    for i = 1:m
        theta2(i) = jointPos(2,i);
        theta3(i) = jointPos(3,i);
        theta4(i) = jointPos(4,i);

        transformPos = robot.fk3001(jointPos(1,:)).';
        storeTaskPos(i,:) = transformPos(4,:);

        x(i) = storeTaskPos(1,4);
        y(i) = storeTaskPos(2,4);
        z(i) = storeTaskPos(3,4);

        xCubic = TrajGenerator.cubic_traj(0, travel_time,x(1,i) , x(1,i+1), 0, 0);
        yCubic = TrajGenerator.cubic_traj(0,travel_time, y(1,i), y(1,i+1), 0, 0);
        zCubic = TrajGenerator.cubic_traj(0, travel_time, z(1,i), z(1,i+1), 0, 0);
       
% Loop through all collected data and convert it from joint-space to task
% space using your fk3001 function

% Plot the trajectory of your robot in x-y-z space using scatter3
% https://www.mathworks.com/help/matlab/ref/scatter3.html
figure;
grid on;
scatter3(x, y, z)
title('Trajectory of the Robot in Task Space')
xlabel('x')
ylabel('y')
zlabel('z')


% Plot the trajectory of your robot in theta2-theta3-theta-4 space using
% scatter3

figure;
grid on;
scatter3(theta2, theta3, theta4)
title('Trajectory of the Robot in Task Space')
xlabel('theta2')
ylabel('theta3')
zlabel('theat4')